  kvagelanLines:
  - "\u0421\u043D\u043E\u0432\u0430 \u043F\u0440\u0438\u0432\u0435\u0442. \u0425\u043E\u0440\u043E\u0448\u043E
    \u0442\u044B \u043C\u043D\u0435 \u043F\u043E\u043C\u043E\u0433, \u0441\u0435\u0439\u0447\u0430\u0441
    \u0437\u0430\u0434\u0430\u0447\u043A\u0430 \u043F\u043E\u0441\u043B\u043E\u0436\u043D\u0435\u0435,
    \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0432 \u0430\u0440\u0445\u0438\u0432\u0435
    \u043D\u0430\u0439\u0442\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0430\u0440\u043D\u044F."
  - "\u041E\u043D \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0441\u0432\u044F\u0437\u0430\u043D
    \u0441 \u043D\u0435\u0434\u0430\u0432\u043D\u0438\u043C \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u0435\u043C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u041F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E
    \u0437\u043E\u0432\u0443\u0442 \u0410\u043B\u0435\u043A\u0441\u0435\u0439."
  - "\u0414\u043E\u0441\u044C\u0435 \u043C\u043D\u0435 \u043E\u0442\u0434\u0430\u0448\u044C."
  - "\u042D\u0442\u0443 \u043A\u0430\u0441\u0441\u0435\u0442\u0443 \u043C\u043D\u0435
    \u0431\u044B\u0432\u0448\u0438\u0439 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A
    \u043E\u0442\u0434\u0430\u043B, \u043D\u0430\u0434\u0435\u044E\u0441\u044C \u043F\u043E\u043C\u043E\u0436\u0435\u0442.
    \u0427\u0442\u043E \u0441 \u043D\u0435\u0439 \u0434\u0435\u043B\u0430\u0442\u044C
    \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C."
  pcTaskHeaderText: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435: \u043D\u0430\u0439\u0434\u0438
