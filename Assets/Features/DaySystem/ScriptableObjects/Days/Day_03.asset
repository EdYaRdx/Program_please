  dayId: day_03
  dayTitle: "\u0414\u0435\u043D\u044C 3"
  dayMode: 0
  kvagelanLines:
  - "\u0423\u0442\u0440\u043E \u0434\u043E\u0431\u0440\u043E\u0435, \u043D\u0430\u0448\u043B\u0438
    \u043C\u044B \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0433\u043E \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E,
    \u043E\u043D \u0431\u044B\u043B \u043D\u0435\u0432\u0438\u043D\u043E\u0432\u0435\u043D,
    \u043D\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0447\u0442\u043E
    \u043E\u043D \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043D\u044B\u043C\u0438
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430\u043C\u0438. \u0412 \u043E\u0431\u0449\u0435\u043C
    \u0441\u043F\u0430\u0441\u0438\u0431\u043E."
  - "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0432\u0435\u0441\u0442\u0438
    \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0432 \u0434\u0435\u043B\u0430\u0445,
    \u043D\u0430\u0439\u0434\u0438 \u043C\u043D\u0435 \u0432\u0441\u0435 \u0434\u043E\u0441\u044C\u0435
    \u0438\u0437 \u0418\u0436\u0435\u0432\u0441\u043A\u0430, \u043D\u0435\u0434\u0430\u0432\u043D\u043E
    \u0442\u0430\u043C \u0433\u0440\u0443\u043F\u043F\u0430 \u0445\u0430\u043A\u0435\u0440\u043E\u0432
    \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0430\u0441\u044C, \u043D\u0443\u0436\u043D\u043E
    \u0432\u0441\u0435\u0445 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
  - "\u0412\u0441\u0435 \u0434\u043E\u0441\u044C\u0435 \u043C\u043D\u0435 \u043E\u0442\u0434\u0430\u0448\u044C,
    \u043D\u0443 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C"
  - "\u041A\u0430\u0441\u0441\u0435\u0442\u0443 \u0432 \u0441\u0435\u0439\u0444\u0435
    \u043D\u0430\u0448\u0435\u043B, \u0434\u0435\u0440\u0436\u0438, \u0442\u0430\u043C
    \u0435\u0449\u0435 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 \u0431\u044B\u043B,
    \u043D\u043E \u044D\u0442\u043E \u043D\u0435 \u0434\u043B\u044F \u0442\u0435\u0431\u044F,
    \u0434\u0430\u0432\u0430\u0439"
  pcTaskHeaderText: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435: \u043E\u0442\u0431\u0435\u0440\u0438
    \u0432\u0441\u0435 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0438 \u043B\u044E\u0434\u0435\u0439
    \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430 [\u0418\u0436\u0435\u0432\u0441\u043A]"
