.dos-root 
{
    flex-direction: column;
    min-height: 0px;
}

#InstallerField 
{
    min-width: 520px;
}

.dos-status 
{
    display: none;
}

.dos-split 
{
    flex-grow: 1;
    min-height: 0px;
}

.dos-pane 
{
    flex-direction: column;
    flex-grow: 1;
    min-height: 0px;
}

.dos-list 
{
    flex-grow: 1;
    min-height: 0px;
}

.dos-header 
{
    unity-font-style: bold;
    margin-left: 8px;
    margin-top: 8px;
    margin-bottom: 6px;
}

.dos-details 
{
    flex-grow: 1;
    min-height: 0px;
    padding-left: 8px;
    padding-right: 8px;
}

.dos-fields-root 
{
    flex-direction: column;
    margin-top: 6px;
}

.dos-rawjson 
{
    min-height: 220px;
}

.dos-footer 
{
    flex-direction: row;
    justify-content: flex-end;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    flex-shrink: 0;
    min-height: 44px;
}

#RevertButton,
#SaveButton,
#DeleteButton 
{
    margin-left: 6px;
}
